local function IsValid(o)
    if not o or not o:IsA("Model") or o.Parent == nil or o.Parent.Name ~= Config.AllowedParent then return false end
    local root = o:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then return false end
    if root.Position.Y < Config.MinHeight then return false end
    if math.abs(root.Position.Y - Config.BuggedHeight) < Config.BuggedTolerance then return false end
    local hp = GetCurrentRealHealth(o)
    if hp > 0 and hp <= Config.DeadHpThreshold then return false end
    if DeadTargets[o] and (tick() - DeadTargets[o]) < 3 then return false end
    return true
end

