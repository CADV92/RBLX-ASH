local NoclipActivo = false
local NoclipConnection = nil

local function setNoclip()
    local char = LocalPlayer.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide == true then
                part.CanCollide = false
            end
        end
    end
end

local function ToggleNoclip()
    NoclipActivo = not NoclipActivo
    if NoclipActivo then
        NoclipConnection = RunService.Stepped:Connect(setNoclip)
        table.insert(_G.CADV_Conexiones, NoclipConnection)
        pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "👻 Noclip V2", Text = "ACTIVADO", Duration = 2 }) end)
    else
        if NoclipConnection then NoclipConnection:Disconnect(); NoclipConnection = nil end
        pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "👻 Noclip V2", Text = "DESACTIVADO", Duration = 2 }) end)
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.CanCollide = true end
    end
end

