local function ParseRaidID(mapId, raidId)
    local mapIndex = mapId - 50000 
    local isAsc = false; local lvlRaw = 0 
    if raidId >= 935000 then 
        isAsc = true; lvlRaw = raidId - 935000 - (mapIndex * 100) 
    else 
        isAsc = false; lvlRaw = raidId - 930000 - ((mapIndex - 1) * 10) 
    end
    local rankStr = isAsc and (RanksMapASC[lvlRaw] or "?") or (RanksMapNormal[lvlRaw] or "?")
    return mapIndex, rankStr, isAsc, lvlRaw
end

local function GetBestGlobalRaid()
    CleanExpiredRaids()
    local best, bestScore, count = nil, -1, 0
    for mapId, info in pairs(ActiveRaids) do
        count = count + 1
        local mapIdx, rankStr, isAsc, gradeVal = ParseRaidID(mapId, info.raidId)
        if not Config.AllowedMaps[mapIdx] then continue end
        if isAsc and not Config.AllowedGradesASC[rankStr] then continue end
        if not isAsc and not Config.AllowedGradesNormal[rankStr] then continue end
        if isAsc and not Config.AllowedModes.ASC then continue end
        if not isAsc and not Config.AllowedModes.Normal then continue end
        if (info.endTime - os.time()) < 10 then continue end
        local modeStr = isAsc and "A" or "N"
        local raidKey = modeStr .. "-" .. tostring(mapIdx) .. "-" .. rankStr
        if Config.Blacklist[raidKey] then continue end
        local score = 0
        local isVip, vipRank = false, 0
        local runeKey = isAsc and ("ASC_" .. rankStr) or rankStr
        local isRuneTarget = Config.Runes and Config.Runes[runeKey] and (Config.Runes[runeKey] > 0)     
        for idx, vipKey in ipairs(Config.VipList) do if raidKey == vipKey then isVip = true; vipRank = idx; break end end
        if isVip then score = 100000000 - (vipRank * 10000)
        elseif isRuneTarget then
            score = 50000000
            if Config.Priority == "MAP" then score = score + (Config.Order == "HIGHEST" and ((mapIdx * 100) + gradeVal) or (((20 - mapIdx) * 100) + gradeVal))
            else score = score + (Config.Order == "HIGHEST" and ((gradeVal * 1000) + mapIdx) or (((20 - gradeVal) * 1000) + mapIdx)) end
        else
            if isAsc then score = score + 10000000 end -- [+10M Prioridad Absoluta ASC]
            if Config.Priority == "MAP" then score = score + (Config.Order == "HIGHEST" and ((mapIdx * 100) + gradeVal) or (((20 - mapIdx) * 100) + gradeVal))
            else score = score + (Config.Order == "HIGHEST" and ((gradeVal * 1000) + mapIdx) or (((20 - gradeVal) * 1000) + mapIdx)) end
        end
        if score > bestScore then bestScore = score; best = { info=info, mapIdx=mapIdx, rank=rankStr, isAsc=isAsc, isVip=isVip, isRune=isRuneTarget } end
    end
    return best, count
end

