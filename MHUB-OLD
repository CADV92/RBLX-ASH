local function ParseValue(str)
    if not str or str == "" then return 0 end
    if str:find("/") then str = str:split("/")[1] end
    local cleanStr = str:gsub("HP:", ""):gsub("Health:", ""):gsub("hp:", ""):gsub("%s+", ""):gsub(",", "")
    local valStr, sufStr = cleanStr:match("^([%d%.]+)(.*)$")
    if valStr then
        local num = tonumber(valStr) or 0
        if sufStr and sufStr ~= "" then local mult = ReadSuffixes[sufStr] if mult then return num * mult end end
        return num
    end
    return 0
end

local function GetCurrentRealHealth(model)
    if not model then return 0 end
    local root = model:FindFirstChild("HumanoidRootPart")
    if root then
        local gui = root:FindFirstChild("EnemyNameGui")
        if gui then
            local progress = gui:FindFirstChild("Progress")
            if progress then
                local healthNum = progress:FindFirstChild("HealthNum")
                if healthNum and healthNum:IsA("TextLabel") then
                    local txt = healthNum.Text
                    if txt == "" or txt == "0" or not txt:match("%d") then return 0 end
                    return ParseValue(txt)
                end
            end
        end
    end
    return 0
end

local function EstaMuerto(model)
    if not model or not model.Parent or not model:FindFirstChild("HumanoidRootPart") then return true end
    local hp = GetCurrentRealHealth(model)
    return hp <= Config.DeadHpThreshold
end

local function EsMobValido(enemy, myRoot)
    if EstaMuerto(enemy) then return false end
    local root = enemy:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local yPos = root.Position.Y
    if yPos < Limites.MinHeight then return false end
    if math.abs(yPos - Limites.BuggedHeight) < Limites.BugTolerance then return false end
    local esBoss = TargetSet[enemy.Name] ~= nil 
    if myRoot then
        local dist = (root.Position - myRoot.Position).Magnitude
        if dist > Limites.MaxDist then 
            if not esBoss then return false end 
        end
    end
    return true
end

local function ObtenerMobPorNombre(nombreBuscado, ignorarInstancia)
    if not nombreBuscado then return nil end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local folder = GetEnemyFolder()
    if not myRoot or not folder then return nil end
    local bestMob = nil
    local bestDist = Limites.MaxDist 
    for _, enemy in pairs(folder:GetChildren()) do
        if enemy.Name == nombreBuscado and enemy ~= ignorarInstancia then
            if EsMobValido(enemy, myRoot) then
                local root = enemy:FindFirstChild("HumanoidRootPart")
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestMob = enemy
                end
            end
        end
    end
    return bestMob
end

