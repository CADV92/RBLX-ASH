    local char = LocalPlayer.Character if not char then return false end
    local petFound, anyPetNear = false, false
    for _, obj in pairs(char:GetChildren()) do
        if obj:IsA("Model") and obj ~= char then
            local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Part")
            if part then 
                petFound = true 
                if (part.Position - char.HumanoidRootPart.Position).Magnitude < Config.PetRange then anyPetNear = true; break end 
            end
        end
    end
    if not petFound then return true end 
    return not anyPetNear
end

local function HandleMovement(targetRoot)
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
    if not myRoot or not targetRoot then return end
    local myPos, mobPos = myRoot.Position, targetRoot.Position
    local dist = (myPos - mobPos).Magnitude
    local idealDist = Config.TPDistance
    if dist < (idealDist + 3) and dist > (idealDist - 2) then
        myRoot.CFrame = CFrame.lookAt(myPos, Vector3.new(mobPos.X, myPos.Y, mobPos.Z))
        myRoot.Velocity = Vector3.new(0,0,0)
    else
        local unit = (myPos - mobPos).Unit
        if unit.Magnitude == 0 then unit = Vector3.new(0,0,1) end
        local targetPos = mobPos + (unit * idealDist)
        myRoot.Velocity = Vector3.new(0,0,0)
        local alpha = (Config.FarmSpeed == 1 and 0.15) or (Config.FarmSpeed == 2 and 0.45) or 1
        if alpha == 1 then myRoot.CFrame = CFrame.new(targetPos, mobPos) 
        else myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.new(targetPos, mobPos), alpha) end
    end
end

