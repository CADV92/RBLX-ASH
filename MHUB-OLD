local function ObtenerNombresNumerados()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local folder = GetEnemyFolder()
    local ListaValidos, Conteo = {}, {}
    if myRoot and folder then
        local tempEnemies = {}
        for _, enemy in pairs(folder:GetChildren()) do
            if EsMobValido(enemy, myRoot) then
                local root = enemy:FindFirstChild("HumanoidRootPart")
                table.insert(tempEnemies, {mob = enemy, dist = (root.Position - myRoot.Position).Magnitude})
            end
        end
        table.sort(tempEnemies, function(a, b) return a.dist < b.dist end)
        for _, data in ipairs(tempEnemies) do
            local enemy = data.mob; Conteo[enemy.Name] = (Conteo[enemy.Name] or 0) + 1
            local isBoss = TargetSet[enemy.Name] ~= nil
            table.insert(ListaValidos, { id = enemy.Name .. " #" .. Conteo[enemy.Name], nombreOriginal = enemy.Name, instancia = enemy, esBoss = isBoss })
        end
    end
    return ListaValidos
end

