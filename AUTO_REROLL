    U.Dup = Instance.new("TextButton", tabFrame); U.Dup.Size = UDim2.new(0.31,0,0,20); U.Dup.Position = UDim2.new(0.67,0,0,startY+15); U.Dup.Text = "Sin Duplis"; U.Dup.Font = Enum.Font.GothamMedium; U.Dup.TextSize = 10; U.Dup.BackgroundColor3 = Theme.Warning; U.Dup.TextColor3 = Theme.TextHighlight; Instance.new("UICorner", U.Dup).CornerRadius = UDim.new(0, 4)
    U.Box = Instance.new("TextBox", tabFrame); U.Box.Size = UDim2.new(0.9,0,0,70); U.Box.Position = UDim2.new(0.05,0,0,startY+40); U.Box.PlaceholderText = "..."; U.Box.Text = ""; U.Box.Font = Enum.Font.Gotham; U.Box.TextSize = 9; U.Box.TextYAlignment = Enum.TextYAlignment.Top; U.Box.TextXAlignment = Enum.TextXAlignment.Left; U.Box.MultiLine = true; U.Box.ClearTextOnFocus = false; U.Box.BackgroundColor3 = Theme.PanelLight; U.Box.TextColor3 = Theme.Primary; Instance.new("UICorner", U.Box).CornerRadius = UDim.new(0, 4); Instance.new("UIStroke", U.Box).Color = Theme.Secondary
    U.Log = Instance.new("ScrollingFrame", tabFrame); U.Log.Size = UDim2.new(0.9,0,0,140); U.Log.Position = UDim2.new(0.05,0,0,startY+115); U.Log.BackgroundColor3 = Theme.PanelLight; U.Log.ScrollBarThickness = 4; Instance.new("UICorner", U.Log).CornerRadius = UDim.new(0, 4); Instance.new("UIStroke", U.Log).Color = Theme.Secondary; U.LogL = Instance.new("UIListLayout", U.Log); U.LogL.SortOrder = Enum.SortOrder.LayoutOrder; U.LogL.Padding = UDim.new(0, 2)
    U.Tog = Instance.new("TextButton", tabFrame); U.Tog.Size = UDim2.new(0.9,0,0,35); U.Tog.Position = UDim2.new(0.05,0,0,startY+265); U.Tog.Text = "INICIAR " .. typeName; U.Tog.Font = Enum.Font.GothamBlack; U.Tog.TextSize = 13; U.Tog.BackgroundColor3 = Theme.Primary; U.Tog.TextColor3 = Theme.BlackText; Instance.new("UICorner", U.Tog).CornerRadius = UDim.new(0, 6)

    U.AddLog = function(msg, color)
        local l = Instance.new("TextLabel", U.Log); l.Size = UDim2.new(1,-10,0,16); l.BackgroundTransparency = 1; l.Position = UDim2.new(0,5,0,0); l.Text = msg; l.Font = Enum.Font.Gotham; l.TextSize = 10; l.TextColor3 = color or Theme.Text; l.TextXAlignment = Enum.TextXAlignment.Left; U.Log.CanvasSize = UDim2.new(0,0,0,U.LogL.AbsoluteContentSize.Y); U.Log.CanvasPosition = Vector2.new(0,U.Log.CanvasSize.Y.Offset)
    end
    U.Clr.MouseButton1Click:Connect(function() U.Box.Text = ""; U.AddLog("🗑️ Lista limpiada.", Theme.Text) end)
    U.Dup.MouseButton1Click:Connect(function() local s,u={},{} for v in string.gmatch(U.Box.Text,uuidPattern) do if not s[v] then s[v]=true table.insert(u,v) end end U.Box.Text = table.concat(u,"\n") U.AddLog(tostring(#u).." IDs únicos.", Theme.Success) end)
    
    -- SISTEMA DE CAPTURA MEJORADO (No se cierra tras un clic, respeta Z-Index superior)
    U.Cap.MouseButton1Click:Connect(function()
        if stateTbl.IsSniffing then 
            stateTbl.IsSniffing = false; if stateTbl.ClickConn then stateTbl.ClickConn:Disconnect() end
            U.Cap.Text = "Capturar"; U.Cap.BackgroundColor3 = Theme.Secondary; return 
        end
        
        stateTbl.IsSniffing = true; U.Cap.Text = "Cancelar"; U.Cap.BackgroundColor3 = Theme.Danger
        U.AddLog("Modo Captura: ACTIVO (Puedes hacer clics múltiples)", Theme.Warning)
        
        stateTbl.ClickConn = UserInputService.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                task.wait(0.05); local mp = UserInputService:GetMouseLocation()
                local guis = LocalPlayer.PlayerGui:GetGuiObjectsAtPosition(mp.X, mp.Y)
                local fu = nil
                
                for _, g in ipairs(guis) do
                    local uid = string.match(g.Name, uuidPattern)
                    if not uid and (g:IsA("TextLabel") or g:IsA("TextButton") or g:IsA("TextBox")) then uid = string.match(g.Text, uuidPattern) end
                    if not uid then for _, a in pairs(g:GetAttributes()) do if type(a)=="string" and string.match(a, uuidPattern) then uid = string.match(a, uuidPattern) break end end end
                    if not uid then for _, c in ipairs(g:GetChildren()) do if c:IsA("StringValue") and string.match(c.Value, uuidPattern) then uid = string.match(c.Value, uuidPattern) break end end end
                    
                    if uid then fu = uid; break end
                end
                
                if fu then 
                    if not string.find(U.Box.Text, fu) then
                        U.Box.Text = (U.Box.Text=="" and fu or U.Box.Text.."\n"..fu)
                        U.AddLog("📸 UUID Atrapado: "..string.sub(fu,1,8), Theme.Success) 
                    end
                end
            end
        end)
    end)
    return U
end

