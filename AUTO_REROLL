    TextHighlight = Color3.fromRGB(255, 255, 255),-- Texto blanco puro
    BlackText = Color3.fromRGB(15, 15, 15)      -- Texto negro para contrastar con el Oro
}

local function ExtractUUIDs(text)
    local list = {}
    for uuid in string.gmatch(text, uuidPattern) do table.insert(list, uuid) end
    return list
end

local function CheckVals(res, tgts)
    if type(res) == "table" then 
        for k, v in pairs(res) do 
            local nv = tonumber(v)
            if nv and table.find(tgts, nv) then return nv end
            if type(v) == "table" then local f = CheckVals(v, tgts); if f then return f end end 
        end
    elseif type(res) == "number" or type(res) == "string" then 
        local nv = tonumber(res); if nv and table.find(tgts, nv) then return nv end 
    end
    return nil
end

